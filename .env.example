# Configure the production value as a Site secret. Never put it in client code.
RUNNINGHUB_API_KEY=
# Optional China-site fallback. Do not reuse the international key implicitly.
RUNNINGHUB_CN_API_KEY=
# Base64-encoded 32 random bytes. Store as a Site secret; do not rotate without re-entering saved keys.
CREDENTIAL_ENCRYPTION_KEY=
# Retained for compatibility; new generations do not use this key.
OPENAI_API_KEY=
